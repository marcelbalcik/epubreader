<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the real theming (ui/Theme.kt). This exists so the window has
      sane colours before the first frame and no ActionBar.
    -->
    <style name="Theme.Lesen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/reader_light_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
