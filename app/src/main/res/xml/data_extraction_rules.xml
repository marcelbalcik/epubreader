<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="lesen.db" />
        <exclude domain="file" path="dict" />
        <exclude domain="file" path="books" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lesen.db" />
        <exclude domain="file" path="dict" />
    </device-transfer>
</data-extraction-rules>
